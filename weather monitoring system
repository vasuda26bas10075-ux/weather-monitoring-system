def daily_humidity():
  humidity=[]
  maximumhumidity=0
  for i in range(1,Days+1):
    print(i,"/",month,"/",year)
    relativehumidity=int(input("Enter the relative humidity level on the above date in percentage :"))
    humidity.append(relativehumidity)
    if relativehumidity>maximumhumidity:
      maximumhumidity=relativehumidity
  i=1
  for x in humidity:
    if x<=100 and x>70:
      print(i,"/",month,"/",year,": Fully Saturated")
    elif x<=70 and x>60:
      print(i,"/",month,"/",year,": Sticky/Damp")
    elif x<=60 and x>50:
      print(i,"/",month,"/",year,": Moderate")
    elif x<=50 and x>30:
      print(i,"/",month,"/",year,": Ideal")
    else:
      print(i,"/",month,"/",year,": Extremely Dry")
    i=i+1  
  print("the humidity levels of each day of", month, "in order are", humidity)
  print("the maximum humidity level in a day for the month of", month, "was", maximumhumidity,"%")  


